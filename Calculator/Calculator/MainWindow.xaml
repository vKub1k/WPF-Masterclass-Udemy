 <Window x:Class="Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculator"
        mc:Ignorable="d"
        Title="MainWindow" Height="525" Width="350" ResizeMode="NoResize">

    <Window.Resources>
    </Window.Resources>
     
    <Grid>
        <Grid.Margin>10</Grid.Margin>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label x:Name="_resultLabel"
               Content="0"
               Grid.ColumnSpan="4"
               HorizontalContentAlignment="Right"
               VerticalContentAlignment="Bottom"/>

        <Button x:Name="_acButton" 
                Style="{StaticResource specialsButtonsStyle}"  
                Content="AC"
                Grid.Row="1"
                Grid.Column="0"/>
        <Button x:Name="_negativeButton" 
                Style="{StaticResource specialsButtonsStyle}"  
                Content="+/-"
                Grid.Row="1"
                Grid.Column="1"/>
        <Button x:Name="_percentageButton" 
                Style="{StaticResource specialsButtonsStyle}"  
                Content="%"
                Grid.Row="1"
                Grid.Column="2"/>
        <Button x:Name="_divideButton"
                Style="{StaticResource operatorsButtonsStyle}"  
                Click="OperationButton_Click"
                Content="/"
                Grid.Row="1"
                Grid.Column="3"/>

        <Button x:Name="_7Button"
                Style="{StaticResource numberButtonsStyle}"
                Click="NumberButton_Click"
                Content="7"
                Grid.Row="2"
                Grid.Column="0"/>
        <Button x:Name="_8Button" 
                Style="{StaticResource numberButtonsStyle}"
                Click="NumberButton_Click"
                Content="8"
                Grid.Row="2"
                Grid.Column="1"/>
        <Button x:Name="_9Button" 
                Style="{StaticResource numberButtonsStyle}"
                Click="NumberButton_Click"
                Content="9"
                Grid.Row="2"
                Grid.Column="2"/>
        <Button x:Name="_multiplyButton" 
                Style="{StaticResource operatorsButtonsStyle}" 
                Click="OperationButton_Click"
                Content="*"
                Grid.Row="2"
                Grid.Column="3"/>

        <Button x:Name="_4Button" 
                Style="{StaticResource numberButtonsStyle}"
                Click="NumberButton_Click"
                Content="4"
                Grid.Row="3"
                Grid.Column="0"/>
        <Button x:Name="_5Button" 
                Style="{StaticResource numberButtonsStyle}"
                Click="NumberButton_Click"
                Content="5"
                Grid.Row="3"
                Grid.Column="1"/>
        <Button x:Name="_6Button" 
                Style="{StaticResource numberButtonsStyle}"
                Click="NumberButton_Click"
                Content="6"
                Grid.Row="3"
                Grid.Column="2"/>
        <Button x:Name="_minusButton" 
                Style="{StaticResource operatorsButtonsStyle}" 
                Click="OperationButton_Click"
                Content="-"
                Grid.Row="3"
                Grid.Column="3"/>

        <Button x:Name="_1Button" 
                Style="{StaticResource numberButtonsStyle}"
                Click="NumberButton_Click"
                Content="1"
                Grid.Row="4"
                Grid.Column="0"/>
        <Button x:Name="_2Button" 
                Style="{StaticResource numberButtonsStyle}"
                Click="NumberButton_Click"
                Content="2"
                Grid.Row="4"
                Grid.Column="1"/>
        <Button x:Name="_3Button" 
                Style="{StaticResource numberButtonsStyle}"
                Click="NumberButton_Click"
                Content="3"
                Grid.Row="4"
                Grid.Column="2"/>
        <Button x:Name="_plusButton" 
                Style="{StaticResource operatorsButtonsStyle}" 
                Click="OperationButton_Click"
                Content="+"
                Grid.Row="4"
                Grid.Column="3"/>

        <Button x:Name="_0Button" 
                Style="{StaticResource numberButtonsStyle}"
                Click="NumberButton_Click"
                Content="0"
                Grid.Row="5"
                Grid.Column="0"
                Grid.ColumnSpan="2"/>
        <Button x:Name="_dotButton" 
                Style="{StaticResource numberButtonsStyle}"                                           
                Click="_dotButton_Click"
                Content="."
                Grid.Row="5"
                Grid.Column="2"/>
        <Button x:Name="_equalButton" 
                Style="{StaticResource operatorsButtonsStyle}" 
                Content="="
                Grid.Row="5"
                Grid.Column="3"/>
    </Grid>
</Window>
